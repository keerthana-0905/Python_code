 
name=['GILL','ABI','RAHUL','JOHN']
marks=[[30,40,50],[50,60,70],[90,76,73],[86,85,63]]
for i in range(4):
    per=sum(marks[i])//3
    if(per>90):
        g="S"
    elif(per>60 and per<90):
        g="A"
